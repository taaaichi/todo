<?xml version="1.0" encoding="utf-8" ?>
<Context displayName="Sample Java" path="/sample" docBase="sample"
    reloadable="true" crossContext="true">
    <Resource name="jdbc/mariadb"
        auth="Container"
        type="javax.sql.DataSource"
        username="sample"
        password="root"
        driverClassName="org.mariadb.jdbc.Driver"
        url="jdbc:mariadb://localhost:3306/todo?useUnicode=true&amp;characterEncoding=utf8"
        maxActive="4"
        maxIdle="10"
        maxWait="5000" 
        validationQuery="SELECT count(*) FROM todos" />
</Context>